# Cloudflare Workers static-asset headers.
# Default for everything is `max-age=0, must-revalidate`, which is right for
# index.html (so a deploy is picked up immediately) but wasteful for the
# fingerprinted and rarely-changing assets below.

# Vite writes content-hashed filenames here, so these can never go stale.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Stable filenames, but they change rarely and a deploy can rename them.
/fonts/*
  Cache-Control: public, max-age=2592000

/videos/*
  Cache-Control: public, max-age=2592000

/posters/*
  Cache-Control: public, max-age=2592000

/images/*
  Cache-Control: public, max-age=2592000

/icons/*
  Cache-Control: public, max-age=2592000
